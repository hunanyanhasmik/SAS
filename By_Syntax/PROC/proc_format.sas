/* 1.1 Create a character format for gender 
   1.2 Create a numeric format for age groups (Create an AGEGRP format) 
   1.3 Create a format for treatment groups. Use OTHER= to handle unexpected values
   1.4 Create a character format with multiple values mapping to one label(US, USA, U.S., UK, GB, CAN, CA)
*/

/* 1.1 */
proc format;
	value $gen_fmt
		'M' = 'Male'
		'F' = 'Fmale';
run;

/* 1.2 */
proc format;
    value agegrp
        0 - 17  = 'Child'
        18 - 64 = 'Adult'
        65 - high = 'Senior';
run;

/* 1.3 */
proc format;
    value trt_fmt
        1 = 'Placebo'
        2 = 'Low Dose'
        3 = 'High Dose'
        other = 'Unknown';
run;

/* 1.4 */
proc format;
	value $country_fmt
        'US', 'USA', 'U.S.' = 'United States'
        'UK', 'GB'          = 'United Kingdom'
        'CAN', 'CA'         = 'Canada'
        other               = 'Other';
run;


data patients;
	length ID Name $15 Gender $5 Age 8 Conutry $3 Treatment 8;
	input ID Name & $ Gender $ Age Conutry $ Treatment;
	format Gender $gen_fmt.  Age agegrp. Conutry $country_fmt. Treatment trt_fmt.;
datalines;
101  Patricia Yang  F 12 US 1 
102  Richard Miller  M 25 USA 2
103  Harry Cook  M 67 UK 2
104  James O'Brien  M 43 CAN 3 
105  Annabelle Stone  F 81 CA 9 
;
run;

proc print data=patients;
run;

















































































































































































































































































































































































































































































































































































































































































































































































































































































































































































